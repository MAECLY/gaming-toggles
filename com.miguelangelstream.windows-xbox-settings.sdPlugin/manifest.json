{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "Icon": "imgs/actions/game-mode/action",
      "Name": "Toggle Game Mode",
      "States": [
        {
          "Image": "imgs/actions/game-mode/off",
          "Name": "Off",
          "Title": "Game Mode\nOFF",
          "TitleAlignment": "bottom",
          "FontSize": 13
        },
        {
          "Image": "imgs/actions/game-mode/on",
          "Name": "On",
          "Title": "Game Mode\nON",
          "TitleAlignment": "bottom",
          "FontSize": 13
        }
      ],
      "Tooltip": "Turn Windows 11 Game Mode on or off.",
      "UserTitleEnabled": false,
      "UUID": "com.miguelangelstream.windows-xbox-settings.game-mode"
    },
    {
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "Icon": "imgs/actions/controller-game-bar/action",
      "Name": "Controller opens Game Bar",
      "States": [
        {
          "Image": "imgs/actions/controller-game-bar/off",
          "Name": "Off",
          "Title": "Pad → Bar\nOFF",
          "TitleAlignment": "bottom",
          "FontSize": 13
        },
        {
          "Image": "imgs/actions/controller-game-bar/on",
          "Name": "On",
          "Title": "Pad → Bar\nON",
          "TitleAlignment": "bottom",
          "FontSize": 13
        }
      ],
      "Tooltip": "Allow or prevent the controller's Xbox button from opening Game Bar.",
      "UserTitleEnabled": false,
      "UUID": "com.miguelangelstream.windows-xbox-settings.controller-game-bar"
    }
  ],
  "Author": "Miguel Esparza",
  "Category": "Xbox · Windows",
  "CategoryIcon": "imgs/plugin/category",
  "CodePath": "bin/plugin.js",
  "Description": "Control Windows 11 Game Mode and the controller's Xbox button from Stream Deck.",
  "Icon": "imgs/plugin/marketplace",
  "Name": "Xbox · Windows",
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "SupportURL": "https://github.com/MAECLY/stream-deck-windows-xbox-settings/issues",
  "URL": "https://www.maecly.com/",
  "UUID": "com.miguelangelstream.windows-xbox-settings",
  "Version": "1.1.1.0"
}